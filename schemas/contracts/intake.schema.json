{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orgnauts intake contract (01-intake.json)",
  "description": "Classification, acceptance criteria (each with a source), scope with evidence, touches, advisory tier, questions.",
  "type": "object",
  "required": [
    "classification",
    "summary",
    "acceptance_criteria",
    "scope",
    "objects",
    "touches",
    "suggested_tier",
    "keywords",
    "questions",
    "visual"
  ],
  "properties": {
    "classification": {
      "type": "string",
      "enum": [
        "BUG",
        "ENHANCEMENT",
        "DATA-FIX",
        "QUESTION"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "technical_hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC\\d{1,3}$"
          },
          "text": {
            "type": "string",
            "minLength": 5
          },
          "source": {
            "type": "string",
            "minLength": 3
          },
          "derived": {
            "type": "boolean"
          }
        }
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "api_name",
          "evidence"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "api_name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,200}$"
          },
          "object": {
            "type": "string"
          },
          "needs_cartography": {
            "type": "boolean"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,200}$"
      }
    },
    "touches": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "apex",
          "flow",
          "data",
          "email",
          "ui",
          "permissions",
          "sharing",
          "integration",
          "reports",
          "lwc",
          "validation",
          "scheduling"
        ]
      }
    },
    "suggested_tier": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "tier_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "cheapest_answer": {
            "type": "string"
          }
        }
      }
    },
    "prior_art": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lessons_applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "injection_notice": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "visual": {
      "type": "object",
      "description": "D-107: rendered by the toolkit to work/<KEY>/visuals/<stage>.html so anyone can read what the issue is and what must be done.",
      "required": [
        "issue",
        "fix",
        "example",
        "mermaid"
      ],
      "properties": {
        "issue": {
          "type": "object",
          "required": [
            "headline",
            "steps",
            "where_it_breaks"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 10,
              "maxLength": 200
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 400
              }
            },
            "where_it_breaks": {
              "type": "string",
              "minLength": 10,
              "maxLength": 600
            }
          }
        },
        "fix": {
          "type": "object",
          "required": [
            "headline",
            "steps"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 10,
              "maxLength": 200
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 400
              }
            }
          }
        },
        "example": {
          "type": "object",
          "required": [
            "record",
            "today",
            "expected"
          ],
          "properties": {
            "record": {
              "type": "string",
              "minLength": 5,
              "maxLength": 600
            },
            "today": {
              "type": "string",
              "minLength": 5,
              "maxLength": 600
            },
            "expected": {
              "type": "string",
              "minLength": 5,
              "maxLength": 600
            }
          }
        },
        "mermaid": {
          "type": "object",
          "required": [
            "issue",
            "fix"
          ],
          "properties": {
            "issue": {
              "type": "string",
              "minLength": 20,
              "maxLength": 4000
            },
            "fix": {
              "type": "string",
              "minLength": 20,
              "maxLength": 4000
            }
          }
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "term",
              "meaning"
            ],
            "properties": {
              "term": {
                "type": "string"
              },
              "meaning": {
                "type": "string"
              }
            }
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "evidence": {
      "$id": "evidence-ref",
      "type": "object",
      "required": [
        "source",
        "ref"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3",
            "L4",
            "vault",
            "tracker",
            "git",
            "human"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "verified_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
