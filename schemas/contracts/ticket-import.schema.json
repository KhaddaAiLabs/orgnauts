{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orgnauts ticket import (work/<KEY>/00-inbox/ticket-import.json)",
  "description": "D-105: what the a1-intake agent saves after reading the ticket through the tracker's MCP server. The toolkit turns it into ticket.json / ticket.md (untrusted envelope). Only `title` is required; copy every field the tracker gave you.",
  "type": "object",
  "required": [
    "title"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,15}-\\d{1,8}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "description": {
      "type": "string",
      "maxLength": 100000
    },
    "status": {
      "type": "string",
      "maxLength": 80
    },
    "priority": {
      "type": "string",
      "maxLength": 80
    },
    "issue_type": {
      "type": "string",
      "maxLength": 80
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "reporter": {
      "type": "string",
      "maxLength": 200
    },
    "assignee": {
      "type": "string",
      "maxLength": 200
    },
    "created": {
      "type": "string",
      "maxLength": 60
    },
    "updated": {
      "type": "string",
      "maxLength": 60
    },
    "acceptance_criteria": {
      "type": "string",
      "maxLength": 20000
    },
    "comments": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "number"
            ]
          },
          "author": {
            "type": "string",
            "maxLength": 200
          },
          "created": {
            "type": "string",
            "maxLength": 60
          },
          "body": {
            "type": "string",
            "maxLength": 50000
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "filename"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "number"
            ]
          },
          "filename": {
            "type": "string",
            "maxLength": 300
          },
          "mimeType": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "created": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 80
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,15}-\\d{1,8}$"
          },
          "title": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "parent": {
      "type": "string",
      "maxLength": 40
    },
    "epic": {
      "type": "string",
      "maxLength": 40
    },
    "source_url": {
      "type": "string",
      "maxLength": 500
    }
  },
  "additionalProperties": true
}
