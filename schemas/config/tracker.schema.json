{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "adapter",
    "project_key",
    "jira",
    "post_draft"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "adapter": {
      "enum": [
        "mcp",
        "jira",
        "file"
      ]
    },
    "project_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,15}$"
    },
    "jira": {
      "type": "object",
      "required": [
        "base_url",
        "email_env",
        "token_env",
        "prior_art_jql",
        "max_results"
      ],
      "properties": {
        "base_url": {
          "type": "string"
        },
        "email_env": {
          "type": "string"
        },
        "token_env": {
          "type": "string"
        },
        "prior_art_jql": {
          "type": "string"
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "post_draft": {
      "const": "disabled"
    },
    "mcp": {
      "type": "object",
      "required": [
        "server",
        "read_tools"
      ],
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
        },
        "kind": {
          "type": "string",
          "maxLength": 40
        },
        "read_tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{1,80}$"
          }
        },
        "prior_art_jql": {
          "type": "string"
        }
      }
    }
  },
  "title": "config/tracker.yaml \u2014 read-only; post_draft is hard-coded disabled; adapter mcp (default) | jira | file"
}
